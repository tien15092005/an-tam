# Sao chép file này thành ".env" rồi điền key. File .env KHÔNG được đưa lên GitHub.

# Mật khẩu PostgreSQL cho docker compose. Mỗi máy tự đặt một mật khẩu riêng.
DB_PASSWORD=

# Mã bí mật để backend gọi AI service. Đặt một chuỗi ngẫu nhiên dài.
AI_SERVICE_TOKEN=

# Ký phiên đăng nhập (JWT) và băm mã mời / mã ghép máy. Mỗi giá trị tối thiểu 32 ký tự ngẫu nhiên.
# Đổi JWT_SECRET sẽ đăng xuất mọi người; đổi CODES_SECRET làm các mã đang chờ hết hiệu lực.
JWT_SECRET=
CODES_SECRET=

# Thông báo đẩy (tùy chọn). Đặt file service account của Firebase vào thư mục secrets/firebase.json
# (thư mục này không lên Git) rồi bỏ dấu # ở dòng dưới. Bỏ trống thì app tự làm mới khi mở.
# FIREBASE_CREDENTIALS=/secrets/firebase.json

# Tài khoản quản trị hệ thống (tùy chọn), tạo một lần khi backend khởi động. Mật khẩu từ 12 ký tự.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ----- Các biến dưới đây chỉ dùng cho bản mẫu cũ (server.py) -----

# Key Google Cloud dùng chung cho:
#   - Cloud Text-to-Speech: giọng đọc tiếng Việt chuẩn trên bản web (bỏ trống = giọng có sẵn trên máy)
#   - Cloud Vision: đọc ảnh toa thuốc (OCR) trong app mobile (bỏ trống = chỉ dán chữ toa thuốc được)
GOOGLE_API_KEY=

# Giọng đọc: vi-VN-Wavenet-A (nữ), vi-VN-Wavenet-B (nam), vi-VN-Wavenet-C (nữ), vi-VN-Wavenet-D (nam),
# hoặc vi-VN-Standard-A..D (rẻ hơn). Danh sách: https://cloud.google.com/text-to-speech/docs/voices
GOOGLE_TTS_VOICE=vi-VN-Wavenet-A

# Tốc độ đọc (1.0 = bình thường; người già nên 0.85 - 0.9)
GOOGLE_TTS_RATE=0.9
