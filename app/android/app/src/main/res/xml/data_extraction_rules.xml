<?xml version="1.0" encoding="utf-8"?>
<!--
  No cloud backup and no device-to-device copy. The saved schedule and unsent answers belong to one paired phone,
  and the session keys in Android's Keystore never travel: a restored copy would open with data it cannot use.
  A new phone is simply paired again with a code from the family.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
