{
  "expo": {
    "name": "An Tâm",
    "slug": "an-tam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.antam.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF7F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "vn.antam.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#E86A33"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "An Tâm cần truy cập ảnh để đọc toa thuốc.",
          "cameraPermission": "An Tâm cần dùng máy ảnh để chụp toa thuốc.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "antam"
  }
}